# Database (Upstash Redis REST, bukan URL rediss://)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session: nilai acak panjang, minimal 32 karakter. Mengganti nilai ini
# membatalkan semua session yang sedang aktif.
AUTH_SECRET=
AUTH_URL=https://aznime.com

# Cloudflare Turnstile (Site Key aman di client, Secret Key hanya server)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=aznime.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Opsional, sudah dipakai halaman lama
GOOGLE_SITE_VERIFICATION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
MAINTENANCE_BYPASS_SECRET=

# Cutover after creating, backing up, importing, and validating the database.
# Leave Redis enabled for sessions, rate limits, caches and temporary records.
AZNIME_PERSISTENCE=redis
# Set to postgres after verifying a history-only import in Redis account mode.
AZNIME_HISTORY_PERSISTENCE=redis
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# No browser Supabase client is used, so no anon or publishable key is required.
